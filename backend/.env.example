# Server
PORT=5000
NODE_ENV=development

# Database
MONGO_URI=mongodb://127.0.0.1:27017/hrms

# Auth
JWT_SECRET=replace_this_with_a_strong_random_secret
JWT_EXPIRES_IN=7d

# Company branding (used on salary slips)
COMPANY_NAME=Agromaxx Industry
COMPANY_ADDRESS=A11, Alkapuri, Saket Nagar, Bhopal 462024
COMPANY_CURRENCY=INR
COMPANY_CURRENCY_SYMBOL=Rs.

# CORS
CLIENT_URL=http://localhost:5173

# Email provider.  Leave unset for local dev (uses Gmail/SMTP below).
# Set to "resend" in production -- Render Free blocks outbound SMTP, so
# the backend routes mail through the Resend HTTPS API instead.
# EMAIL_PROVIDER=resend
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
# SMTP_FROM_EMAIL=onboarding@resend.dev    # pre-verified; swap for your verified domain later

# SMTP (Gmail).  Use an App Password (not your normal Gmail password).
# 1) Enable 2-Step Verification on the Gmail account.
# 2) Visit https://myaccount.google.com/apppasswords and generate one.
# 3) Paste the 16-char password (no spaces) below.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_EMAIL=supportagross@gmail.com
SMTP_PASSWORD=
SMTP_FROM_NAME=HRMS Support

# Password reset settings
PASSWORD_RESET_TOKEN_TTL_MIN=30

# HRMS portal URL used in transactional emails (welcome, etc.)
HRMS_LOGIN_URL=https://hrms-alpha-weld.vercel.app
